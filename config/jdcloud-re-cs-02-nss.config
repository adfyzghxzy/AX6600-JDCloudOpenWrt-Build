# BIẾN THỂ NSS — ghép sau jdcloud-re-cs-02-common.config.
# LÕI NSS — firmware IPQ60xx + driver + ECM cần được build đồng bộ.
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# THÀNH PHẦN NSS CHO BRIDGE, VLAN VÀ PPPoE.
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y

# TĂNG TỐC WI-FI NSS — cần bộ patch mac80211/ath11k của nguồn tham khảo.
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set

# KHO APK — chỉ dùng feed NSS để build, không sinh URL giả trên downloads.openwrt.org.
# Các package NSS phía trên vẫn được tích hợp vào firmware.
# CONFIG_FEED_nss_packages is not set

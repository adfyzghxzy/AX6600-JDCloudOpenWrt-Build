# BIẾN THỂ STANDARD — ghép sau jdcloud-re-cs-02-common.config.
# qca-nss-dp là driver Ethernet cần thiết trên phần cứng này.
CONFIG_PACKAGE_kmod-qca-nss-dp=y

# Bộ firmware NSS, driver tăng tốc và ECM không được chọn.
# CONFIG_PACKAGE_nss-firmware-ipq60xx is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv is not set
# CONFIG_PACKAGE_kmod-qca-nss-ecm is not set
# CONFIG_PACKAGE_MAC80211_NSS_SUPPORT is not set
# CONFIG_ATH11K_NSS_SUPPORT is not set

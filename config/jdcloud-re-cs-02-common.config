# CẤU HÌNH DÙNG CHUNG — JDCloud AX6600 (RE-CS-02)
# Mã hóa UTF-8. Chú thích tiếng Việt, tên tùy chọn giữ nguyên theo OpenWrt.
# Dòng =y tích hợp vào firmware. Dòng “is not set” là lựa chọn đang tắt.
# Workflow ghép file này với file riêng của Standard hoặc NSS trước make defconfig.

# PHẦN CỨNG VÀ ĐỊNH DẠNG FIRMWARE
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# GIAO DIỆN — Argon và tiếng Việt
# Argon đang dùng đã tích hợp trang cấu hình, không cần gói tương thích cũ.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-vi=y
CONFIG_LUCI_LANG_vi=y

# LƯU CẤU HÌNH TRÊN eMMC — bật đủ driver, công cụ tạo và kiểm tra F2FS.
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_f2fsck=y

# MÀN HÌNH LED ATHENA — giao diện JS và chương trình điều khiển đi cùng nhau.
# Bật dịch vụ khi khởi động. Mặc định chỉ hiển thị giờ; các mục khác tắt.
# zoneinfo cung cấp dữ liệu múi giờ để đồng hồ dùng Asia/Ho_Chi_Minh.
CONFIG_PACKAGE_luci-app-athena-led=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y

# TERMINAL TRÊN WEB — luci-app-ttyd cần dịch vụ ttyd.
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# DRIVER USB/WWAN DÙNG CHUNG — phục vụ các nhóm QMI, MBIM và cổng AT.
# Chỉ có driver chưa đủ quay số; cần thêm một nhóm giao thức bên dưới.
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-mii=y

# INTERFACE QMI — giao diện LuCI + uqmi + driver QMI/WDM dùng chung.
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_uqmi=y

# INTERFACE MBIM — giao diện LuCI + umbim + driver MBIM/WDM dùng chung.
# Nhóm này quay số độc lập với ModemManager.
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_wwan=y

# THEO DÕI KẾT NỐI — bật conntrack events; ECM cần nhận vòng đời kết nối.
# Giữ cùng hỗ trợ này ở hai biến thể để thuận tiện kiểm tra.
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# MODEMMANAGER — phương thức quản lý thay thế, cả nhóm đang tắt.
# CONFIG_PACKAGE_luci-proto-modemmanager is not set
# CONFIG_PACKAGE_modemmanager is not set
# CONFIG_PACKAGE_modemmanager-rpcd is not set

# NCM VÀ 3G SERIAL — từng nhóm gồm giao diện và công cụ quay số, đang tắt.
# CONFIG_PACKAGE_luci-proto-ncm is not set
# CONFIG_PACKAGE_comgt-ncm is not set
# CONFIG_PACKAGE_luci-proto-3g is not set
# CONFIG_PACKAGE_comgt is not set

# CÔNG CỤ MODEM TÙY CHỌN — đang tắt.
# CONFIG_PACKAGE_picocom is not set
# CONFIG_PACKAGE_usbutils is not set
# CONFIG_PACKAGE_socat is not set
# CONFIG_PACKAGE_qmi-utils is not set
# CONFIG_PACKAGE_mbim-utils is not set
# CONFIG_PACKAGE_usb-modeswitch is not set

# NHIỀU ĐƯỜNG WAN — bật cả giao diện và backend khi dùng MWAN3.
# CONFIG_PACKAGE_luci-app-mwan3 is not set
# CONFIG_PACKAGE_mwan3 is not set

# QUẢN LÝ eSIM — đang tắt.
# CONFIG_PACKAGE_lpac is not set

# MODEMDATA, QUECTEL RIÊNG HÃNG VÀ XMM — đã tìm được nguồn tham khảo.
# Chỉ chọn sau khi nguồn tương ứng được tích hợp và kiểm tra.


# TỐI ƯU BUILD — cache trình biên dịch; không thêm ứng dụng vào firmware.
CONFIG_CCACHE=y

# JDCloud AX6600 RE-CS-02 / OpenWrt 25.12.6 + pinned LiBwrt NSS layer.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# LuCI + Argon + Vietnamese. Current Argon includes its configuration page.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-vi=y
CONFIG_LUCI_LANG_vi=y

# Persistent eMMC overlay: filesystem module and format/check tools together.
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_f2fsck=y

# Terminal application: LuCI frontend requires ttyd backend.
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# USB WWAN hardware support shared by QMI, MBIM and serial modem protocols.
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-mii=y

# QMI Interface: frontend + uqmi backend + shared QMI driver.
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_uqmi=y

# MBIM Interface: frontend + umbim backend + shared MBIM driver.
# This group can connect MBIM modems independently of ModemManager.
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_wwan=y

# Conntrack event delivery required by ECM connection lifecycle tracking.
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# NSS core: firmware, driver and ECM must be built together.
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# NSS clients for bridge, VLAN and PPPoE.
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y

# NSS Wi-Fi hooks and driver parameters are supplied by the staged NSS layer.
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set

# Alternative modem manager. Enable the group when this method is required.
# CONFIG_PACKAGE_luci-proto-modemmanager is not set
# CONFIG_PACKAGE_modemmanager is not set
# CONFIG_PACKAGE_modemmanager-rpcd is not set

# NCM and serial 3G connection groups, disabled until selected.
# CONFIG_PACKAGE_luci-proto-ncm is not set
# CONFIG_PACKAGE_comgt-ncm is not set
# CONFIG_PACKAGE_luci-proto-3g is not set
# CONFIG_PACKAGE_comgt is not set

# Diagnostic tools and optional applications.
# CONFIG_PACKAGE_picocom is not set
# CONFIG_PACKAGE_usbutils is not set
# CONFIG_PACKAGE_socat is not set
# CONFIG_PACKAGE_qmi-utils is not set
# CONFIG_PACKAGE_mbim-utils is not set
# CONFIG_PACKAGE_usb-modeswitch is not set
# CONFIG_PACKAGE_luci-app-mwan3 is not set
# CONFIG_PACKAGE_mwan3 is not set
# CONFIG_PACKAGE_lpac is not set

# External app groups (Athena, modemdata, Quectel-specific and XMM) require
# their separately audited sources before enabling. They are not selected here.
